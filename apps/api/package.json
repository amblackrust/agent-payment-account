{
  "name": "@agent-payment/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --filter @agent-payment/api... build && node ../../scripts/run-with-root-env.mjs pnpm --filter @agent-payment/api exec tsx watch src/server.ts",
    "dev:worker": "pnpm --filter @agent-payment/api... build && node ../../scripts/run-with-root-env.mjs pnpm --filter @agent-payment/api exec tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-payment/contracts": "workspace:*",
    "@agent-payment/core": "workspace:*",
    "@agent-payment/db": "workspace:*",
    "@agent-payment/solana-rail": "workspace:*",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.2.0",
    "@x402/core": "2.26.0",
    "@x402/svm": "2.26.0",
    "fastify": "5.12.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@agent-payment/sdk": "workspace:*",
    "@solana/surfpool": "1.5.0",
    "tsx": "4.23.13"
  }
}
