    "@agent-payment/solana-rail": "workspace:*",
    "dotenv": "17.4.2",
    "fastify": "5.12.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.2.0",
    "@solana/surfpool": "1.5.0",
    "tsx": "4.23.13"
  }
}
