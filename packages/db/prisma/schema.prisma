generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum AgentAccountStatus {
  PROVISIONING
  ACTIVE
  DISABLED
  PROVISIONING_FAILED
}

enum AgentCredentialStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ROTATING
}

enum PaymentKind {
  PAY
  SEND
  REFUND
}

enum PaymentStatus {
  CREATED
  ROUTING
  AWAITING_APPROVAL
  REJECTED_BY_POLICY
  REJECTED
  SUBMITTED
  RECONCILING
  CONFIRMED
  PROVED_NO_EFFECT
  REVIEW_REQUIRED
  CLOSED_UNRESOLVED
  FAILED
  EXPIRED
}

enum PaymentAttemptStatus {
  CREATED
  PREPARED
  EXECUTING
  SUBMITTED
  RECONCILING
  CONFIRMED
  FAILED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
}

enum ReceiveRequestStatus {
  OPEN
  PAID
  EXPIRED
  CANCELLED
}

enum IncomingPaymentStatus {
  CONFIRMED
}

enum IncomingReconciliationIssueStatus {
  PENDING
  RESOLVED
}

model AgentAccount {
  id                      String                        @id @db.VarChar(64)
  name                    String                        @db.VarChar(120)
  status                  AgentAccountStatus            @default(ACTIVE)
  solanaPublicKey         String                        @unique @map("solana_public_key") @db.VarChar(64)
  encryptedSolanaSecret   String                        @map("encrypted_solana_secret") @db.Text
  encryptionNonce         String                        @map("encryption_nonce") @db.VarChar(32)
  encryptionAuthTag       String                        @map("encryption_auth_tag") @db.VarChar(32)
  workspaceId             String?                       @map("workspace_id") @db.VarChar(64)
  runtimeVersion          String?                       @map("runtime_version") @db.VarChar(64)
  provisioningFailureCode String?                       @map("provisioning_failure_code") @db.VarChar(128)
  disabledAt              DateTime?                     @map("disabled_at")
  disabledReason          String?                       @map("disabled_reason") @db.Text
  rowVersion              Int                           @default(1) @map("row_version")
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")
  credentials             ApiCredential[]
  recipients              Recipient[]
  managedRecipients       Recipient[]                   @relation("ManagedRecipients")
  outgoingPayments        Payment[]                     @relation("PayerPayments")
  incomingPayments        IncomingPayment[]
  receiveRequests         ReceiveRequest[]
  idempotencyRecords      IdempotencyRecord[]
  outgoingReservations    OutgoingReservation[]
  feeSponsorships         FeeSponsorship[]
  indexerCheckpoints      IndexerCheckpoint[]
  incomingIssues          IncomingReconciliationIssue[]
  recoveryEnvelopes       CredentialRecoveryEnvelope[]

  @@index([workspaceId])
  @@map("agent_accounts")
}

model ApiCredential {
  id            String                @id @db.VarChar(64)
  accountId     String                @map("account_id") @db.VarChar(64)
  keyHash       String                @unique @map("key_hash") @db.VarChar(128)
  keyPrefix     String                @map("key_prefix") @db.VarChar(32)
  status        AgentCredentialStatus @default(ACTIVE)
  scopes        String                @default("[]") @db.Text
  expiresAt     DateTime?             @map("expires_at")
  rotatedFromId String?               @map("rotated_from_id") @db.VarChar(64)
  rowVersion    Int                   @default(1) @map("row_version")
  createdAt     DateTime              @default(now()) @map("created_at")
  revokedAt     DateTime?             @map("revoked_at")
  lastUsedAt    DateTime?             @map("last_used_at")
  account       AgentAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@map("api_credentials")
}

model CredentialRecoveryEnvelope {
  idempotencyKey String       @id @map("idempotency_key") @db.VarChar(255)
  accountId      String       @map("account_id") @db.VarChar(64)
  credentialId   String       @map("credential_id") @db.VarChar(64)
  ciphertext     String       @db.Text
  nonce          String       @db.VarChar(64)
  authTag        String       @map("auth_tag") @db.VarChar(64)
  expiresAt      DateTime     @map("expires_at")
  acknowledgedAt DateTime?    @map("acknowledged_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  account        AgentAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, expiresAt])
  @@map("credential_recovery_envelopes")
}

model Recipient {
  id               String                 @id @db.VarChar(64)
  ownerAccountId   String                 @map("owner_account_id") @db.VarChar(64)
  managedAccountId String?                @map("managed_account_id") @db.VarChar(64)
  displayName      String                 @map("display_name") @db.VarChar(120)
  type             String                 @db.VarChar(64)
  archivedAt       DateTime?              @map("archived_at")
  rowVersion       Int                    @default(1) @map("row_version")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  ownerAccount     AgentAccount           @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)
  managedAccount   AgentAccount?          @relation("ManagedRecipients", fields: [managedAccountId], references: [id], onDelete: Restrict)
  destinations     RecipientDestination[]
  payments         Payment[]

  @@index([ownerAccountId])
  @@index([managedAccountId])
  @@map("recipients")
}

model RecipientDestination {
  id            String    @id @db.VarChar(64)
  recipientId   String    @map("recipient_id") @db.VarChar(64)
  rail          String    @db.VarChar(64)
  type          String    @db.VarChar(64)
  walletAddress String    @map("wallet_address") @db.VarChar(128)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  recipient     Recipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([recipientId])
  @@map("recipient_destinations")
}

model Payment {
  id                        String               @id @db.VarChar(64)
  payerAccountId            String               @map("payer_account_id") @db.VarChar(64)
  payerPublicKey            String?              @map("payer_public_key") @db.VarChar(64)
  recipientId               String?              @map("recipient_id") @db.VarChar(64)
  kind                      PaymentKind
  amountAtomic              BigInt               @map("amount_atomic")
  denominationId            String?              @map("denomination_id") @db.VarChar(64)
  amountScale               Int?                 @map("amount_scale")
  currency                  String               @db.VarChar(3)
  status                    PaymentStatus        @default(CREATED)
  description               String?              @db.Text
  externalReference         String?              @map("external_reference") @db.VarChar(255)
  route                     String?              @db.VarChar(64)
  routeId                   String?              @map("route_id") @db.VarChar(64)
  routeSelectionReason      String?              @map("route_selection_reason") @db.VarChar(64)
  settlementAssetId         String?              @map("settlement_asset_id") @db.VarChar(64)
  destinationSnapshotJson   String?              @map("destination_snapshot_json") @db.Text
  policyDecisionId          String?              @map("policy_decision_id") @db.VarChar(64)
  approvalId                String?              @map("approval_id") @db.VarChar(64)
  executionState            String               @default("NOT_STARTED") @map("execution_state") @db.VarChar(32)
  settlementState           String               @default("NOT_SUBMITTED") @map("settlement_state") @db.VarChar(32)
  outcomeState              String               @default("NONE") @map("outcome_state") @db.VarChar(32)
  rowVersion                Int                  @default(1) @map("row_version")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  confirmedAt               DateTime?            @map("confirmed_at")
  failedAt                  DateTime?            @map("failed_at")
  failureCode               String?              @map("failure_code") @db.VarChar(64)
  failureMessageSafe        String?              @map("failure_message_safe") @db.Text
  destinationRail           String?              @map("destination_rail") @db.VarChar(64)
  destinationType           String?              @map("destination_type") @db.VarChar(64)
  destinationReference      String?              @map("destination_reference") @db.VarChar(255)
  recipientManagedAccountId String?              @map("recipient_managed_account_id") @db.VarChar(64)
  originalPaymentId         String?              @map("original_payment_id") @db.VarChar(64)
  counterpartyAccountId     String?              @map("counterparty_account_id") @db.VarChar(64)
  counterpartyAddress       String?              @map("counterparty_address") @db.VarChar(128)
  lastRecoveryAttemptAt     DateTime?            @map("last_recovery_attempt_at")
  nextRecoveryAt            DateTime?            @map("next_recovery_at")
  recoveryCount             Int                  @default(0) @map("recovery_count")
  stuckSince                DateTime?            @map("stuck_since")
  payerAccount              AgentAccount         @relation("PayerPayments", fields: [payerAccountId], references: [id], onDelete: Restrict)
  recipient                 Recipient?           @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  originalPayment           Payment?             @relation("PaymentRefunds", fields: [originalPaymentId], references: [id], onDelete: Restrict)
  refunds                   Payment[]            @relation("PaymentRefunds")
  attempts                  PaymentAttempt[]
  reservation               OutgoingReservation?

  @@index([payerAccountId, createdAt])
  @@index([recipientId, createdAt])
  @@index([payerAccountId, status])
  @@index([status, nextRecoveryAt, lastRecoveryAttemptAt])
  @@index([payerAccountId, denominationId, createdAt])
  @@index([policyDecisionId])
  @@map("payments")
}

model ReceiveRequest {
  id                       String               @id @db.VarChar(64)
  accountId                String               @map("account_id") @db.VarChar(64)
  amountAtomic             BigInt?              @map("amount_atomic")
  denominationId           String?              @map("denomination_id") @db.VarChar(64)
  amountScale              Int?                 @map("amount_scale")
  currency                 String               @db.VarChar(3)
  reference                String               @db.VarChar(255)
  status                   ReceiveRequestStatus @default(OPEN)
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  expiresAt                DateTime?            @map("expires_at")
  paidAt                   DateTime?            @map("paid_at")
  matchedIncomingPaymentId String?              @unique @map("matched_incoming_payment_id") @db.VarChar(64)
  account                  AgentAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  matchedIncomingPayment   IncomingPayment?     @relation("ReceiveMatch", fields: [matchedIncomingPaymentId], references: [id], onDelete: Restrict)
  incomingPayments         IncomingPayment?     @relation("ReceiveIncoming")

  @@unique([accountId, reference])
  @@index([accountId, status])
  @@map("receive_requests")
}

model IncomingPayment {
  id               String                @id @db.VarChar(64)
  accountId        String                @map("account_id") @db.VarChar(64)
  signature        String                @db.VarChar(128)
  amountAtomic     BigInt                @map("amount_atomic")
  tokenAtomicUnits BigInt                @map("token_atomic_units")
  tokenDecimals    Int                   @map("token_decimals")
  currency         String                @db.VarChar(3)
  sourceAddress    String?               @map("source_address") @db.VarChar(128)
  reference        String?               @db.VarChar(255)
  tokenAccount     String                @map("token_account") @db.VarChar(128)
  settlementMint   String                @map("settlement_mint") @db.VarChar(128)
  status           IncomingPaymentStatus @default(CONFIRMED)
  createdAt        DateTime              @default(now()) @map("created_at")
  confirmedAt      DateTime              @default(now()) @map("confirmed_at")
  receiveRequestId String?               @unique @map("receive_request_id") @db.VarChar(64)
  account          AgentAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  receiveRequest   ReceiveRequest?       @relation("ReceiveIncoming", fields: [receiveRequestId], references: [id], onDelete: Restrict)
  matchedByRequest ReceiveRequest?       @relation("ReceiveMatch")

  @@unique([accountId, signature])
  @@index([accountId, createdAt])
  @@index([accountId, receiveRequestId])
  @@map("incoming_payments")
}

model IndexerCheckpoint {
  id              String       @id @db.VarChar(64)
  accountId       String       @map("account_id") @db.VarChar(64)
  rail            String       @db.VarChar(64)
  address         String       @db.VarChar(128)
  cursorSignature String?      @map("cursor_signature") @db.VarChar(128)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  account         AgentAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, rail, address])
  @@map("indexer_checkpoints")
}

model IncomingReconciliationIssue {
  id          String                            @id @db.VarChar(64)
  accountId   String                            @map("account_id") @db.VarChar(64)
  signature   String                            @db.VarChar(128)
  status      IncomingReconciliationIssueStatus @default(PENDING)
  reason      String                            @db.VarChar(128)
  firstSeenAt DateTime                          @default(now()) @map("first_seen_at")
  lastTriedAt DateTime?                         @map("last_tried_at")
  nextRetryAt DateTime                          @default(now()) @map("next_retry_at")
  retryCount  Int                               @default(0) @map("retry_count")
  resolvedAt  DateTime?                         @map("resolved_at")
  account     AgentAccount                      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, signature])
  @@index([status, nextRetryAt])
  @@index([accountId, status])
  @@map("incoming_reconciliation_issues")
}

model PaymentAttempt {
  id                            String               @id @db.VarChar(64)
  paymentId                     String               @map("payment_id") @db.VarChar(64)
  attemptNumber                 Int                  @map("attempt_number")
  rail                          String               @db.VarChar(64)
  status                        PaymentAttemptStatus @default(CREATED)
  railTransactionId             String?              @map("rail_transaction_id") @db.VarChar(255)
  serializedPayloadSafe         String?              @map("serialized_payload_safe") @db.Text
  durablePayload                String?              @map("durable_payload") @db.Text
  expectedExternalId            String?              @map("expected_external_id") @db.VarChar(255)
  recoveryMetadata              String?              @map("recovery_metadata") @db.Text
  confirmationMetadata          String?              @map("confirmation_metadata") @db.Text
  outcome                       String               @default("NOT_STARTED") @db.VarChar(32)
  routeId                       String?              @map("route_id") @db.VarChar(64)
  preparedEffectHash            String?              @map("prepared_effect_hash") @db.Char(64)
  signedPayloadHash             String?              @map("signed_payload_hash") @db.Char(64)
  signedPayloadEncrypted        String?              @map("signed_payload_encrypted") @db.Text
  validityExpiresAt             DateTime?            @map("validity_expires_at")
  validitySlot                  BigInt?              @map("validity_slot")
  rowVersion                    Int                  @default(1) @map("row_version")
  legacySignedTransactionBase64 String?              @map("signed_transaction_base64") @db.Text
  legacyExpectedSignature       String?              @map("expected_signature") @db.VarChar(128)
  legacyBlockhash               String?              @map("blockhash") @db.VarChar(128)
  legacyLastValidBlockHeight    BigInt?              @map("last_valid_block_height")
  legacyConfirmedSlot           BigInt?              @map("confirmed_slot")
  createdAt                     DateTime             @default(now()) @map("created_at")
  updatedAt                     DateTime             @updatedAt @map("updated_at")
  payment                       Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, attemptNumber])
  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

model IdempotencyRecord {
  id               String       @id @db.VarChar(64)
  ownerAccountId   String       @map("owner_account_id") @db.VarChar(64)
  operation        String       @db.VarChar(32)
  key              String       @db.VarChar(255)
  requestHash      String       @map("request_hash") @db.Char(64)
  fingerprint      String?      @db.Char(64)
  resourceId       String       @map("resource_id") @db.VarChar(64)
  responseSnapshot String?      @map("response_snapshot") @db.Text
  expiresAt        DateTime?    @map("expires_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  ownerAccount     AgentAccount @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)

  @@unique([ownerAccountId, operation, key])
  @@index([ownerAccountId, createdAt])
  @@map("idempotency_records")
}

model OutgoingReservation {
  id             String            @id @db.VarChar(64)
  paymentId      String            @unique @map("payment_id") @db.VarChar(64)
  ownerAccountId String            @map("owner_account_id") @db.VarChar(64)
  amountAtomic   BigInt            @map("amount_atomic")
  currency       String            @db.VarChar(3)
  status         ReservationStatus @default(ACTIVE)
  lifecycleState String            @default("HELD") @map("lifecycle_state") @db.VarChar(16)
  releaseReason  String?           @map("release_reason") @db.VarChar(128)
  consumedAt     DateTime?         @map("consumed_at")
  rowVersion     Int               @default(1) @map("row_version")
  createdAt      DateTime          @default(now()) @map("created_at")
  releasedAt     DateTime?         @map("released_at")
  payment        Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  ownerAccount   AgentAccount      @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)

  @@index([ownerAccountId, status])
  @@map("outgoing_reservations")
}

model FeeSponsorship {
  id        String       @id @db.VarChar(64)
  accountId String       @map("account_id") @db.VarChar(64)
  paymentId String       @unique @map("payment_id") @db.VarChar(64)
  lamports  BigInt
  createdAt DateTime     @default(now()) @map("created_at")
  account   AgentAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@map("fee_sponsorships")
}

model RuntimeMetadata {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Denomination {
  id        String   @id @db.VarChar(64)
  symbol    String   @db.VarChar(32)
  maxScale  Int      @map("max_scale")
  status    String   @default("ACTIVE") @db.VarChar(16)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([symbol, version])
  @@map("denominations")
}

model SettlementAsset {
  id             String   @id @db.VarChar(64)
  rail           String   @db.VarChar(64)
  network        String   @db.VarChar(64)
  assetReference String   @map("asset_reference") @db.VarChar(255)
  decimals       Int
  status         String   @default("ACTIVE") @db.VarChar(16)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([rail, network, assetReference, version])
  @@map("settlement_assets")
}

model EconomicMapping {
  id                String   @id @db.VarChar(64)
  denominationId    String   @map("denomination_id") @db.VarChar(64)
  settlementAssetId String   @map("settlement_asset_id") @db.VarChar(64)
  numerator         BigInt
  denominator       BigInt
  status            String   @default("ACTIVE") @db.VarChar(16)
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([denominationId, status])
  @@index([settlementAssetId, status])
  @@map("economic_mappings")
}

model SettlementRoute {
  id                String   @id @db.VarChar(64)
  rail              String   @db.VarChar(64)
  railVersion       String   @map("rail_version") @db.VarChar(64)
  network           String   @db.VarChar(64)
  settlementAssetId String   @map("settlement_asset_id") @db.VarChar(64)
  economicMappingId String   @map("economic_mapping_id") @db.VarChar(64)
  status            String   @default("ACTIVE") @db.VarChar(16)
  priority          Int      @default(0)
  configVersion     String   @map("config_version") @db.VarChar(64)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([status, priority, id])
  @@map("settlement_routes")
}

model SpendPolicy {
  id                          String    @id @db.VarChar(64)
  accountId                   String    @map("account_id") @db.VarChar(64)
  version                     Int
  status                      String    @default("DRAFT") @db.VarChar(16)
  denominationId              String    @map("denomination_id") @db.VarChar(64)
  maxPerPaymentAtomic         BigInt?   @map("max_per_payment_atomic")
  rollingBudgetAtomic         BigInt?   @map("rolling_budget_atomic")
  rollingWindowSeconds        Int?      @map("rolling_window_seconds")
  transactionCountCap         Int?      @map("transaction_count_cap")
  approvalThresholdAtomic     BigInt?   @map("approval_threshold_atomic")
  rollingBudgetEscalatable    Boolean   @default(false) @map("rolling_budget_escalatable")
  transactionCountEscalatable Boolean   @default(false) @map("transaction_count_escalatable")
  rulesJson                   String    @default("{}") @map("rules_json") @db.Text
  createdAt                   DateTime  @default(now()) @map("created_at")
  activatedAt                 DateTime? @map("activated_at")
  retiredAt                   DateTime? @map("retired_at")

  @@unique([accountId, version])
  @@index([accountId, status])
  @@map("spend_policies")
}

model PolicyDecision {
  id              String   @id @db.VarChar(64)
  paymentId       String   @unique @map("payment_id") @db.VarChar(64)
  accountId       String   @map("account_id") @db.VarChar(64)
  policyId        String   @map("policy_id") @db.VarChar(64)
  policyVersion   Int      @map("policy_version")
  decision        String   @db.VarChar(32)
  reasonCodesJson String   @map("reason_codes_json") @db.Text
  contextJson     String   @map("context_json") @db.Text
  fingerprint     String   @db.Char(64)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([accountId, createdAt])
  @@map("policy_decisions")
}

model ApprovedDestination {
  id             String    @id @db.VarChar(64)
  accountId      String    @map("account_id") @db.VarChar(64)
  fingerprint    String    @db.Char(64)
  rail           String    @db.VarChar(64)
  network        String    @db.VarChar(64)
  assetReference String    @map("asset_reference") @db.VarChar(255)
  destination    String    @db.VarChar(255)
  status         String    @default("ACTIVE") @db.VarChar(16)
  actorId        String    @map("actor_id") @db.VarChar(128)
  reason         String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")

  @@unique([accountId, fingerprint])
  @@index([accountId, status])
  @@map("approved_destinations")
}

model Approval {
  id               String    @id @db.VarChar(64)
  paymentId        String    @unique @map("payment_id") @db.VarChar(64)
  accountId        String    @map("account_id") @db.VarChar(64)
  fingerprint      String    @db.Char(64)
  policyDecisionId String    @map("policy_decision_id") @db.VarChar(64)
  status           String    @default("PENDING") @db.VarChar(16)
  expiresAt        DateTime  @map("expires_at")
  actorId          String?   @map("actor_id") @db.VarChar(128)
  comment          String?   @db.Text
  rowVersion       Int       @default(1) @map("row_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  decidedAt        DateTime? @map("decided_at")

  @@index([accountId, status, expiresAt])
  @@map("approvals")
}

model DurableWorkItem {
  id             String    @id @db.VarChar(64)
  kind           String    @db.VarChar(64)
  resourceType   String    @map("resource_type") @db.VarChar(64)
  resourceId     String    @map("resource_id") @db.VarChar(64)
  status         String    @default("AVAILABLE") @db.VarChar(16)
  availableAt    DateTime  @default(now()) @map("available_at")
  leaseOwner     String?   @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt DateTime? @map("lease_expires_at")
  attemptCount   Int       @default(0) @map("attempt_count")
  maxAttempts    Int       @default(10) @map("max_attempts")
  lastErrorCode  String?   @map("last_error_code") @db.VarChar(128)
  lastErrorSafe  String?   @map("last_error_safe") @db.Text
  retryAfter     DateTime? @map("retry_after")
  payloadJson    String    @default("{}") @map("payload_json") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  completedAt    DateTime? @map("completed_at")

  @@unique([kind, resourceType, resourceId])
