generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum AgentAccountStatus {
  ACTIVE
  DISABLED
}

enum PaymentKind {
  PAY
  SEND
  REFUND
}

enum PaymentStatus {
  CREATED
  ROUTING
  SUBMITTED
  RECONCILING
  CONFIRMED
  FAILED
}

enum PaymentAttemptStatus {
  CREATED
  PREPARED
  EXECUTING
  SUBMITTED
  RECONCILING
  CONFIRMED
  FAILED
}

enum ReservationStatus {
  ACTIVE
  RELEASED
}

enum ReceiveRequestStatus {
  OPEN
  PAID
  EXPIRED
  CANCELLED
}

enum IncomingPaymentStatus {
  CONFIRMED
}

model AgentAccount {
  id                    String                @id @db.VarChar(64)
  name                  String                @db.VarChar(120)
  status                AgentAccountStatus    @default(ACTIVE)
  solanaPublicKey       String                @unique @map("solana_public_key") @db.VarChar(64)
  encryptedSolanaSecret String                @map("encrypted_solana_secret") @db.Text
  encryptionNonce       String                @map("encryption_nonce") @db.VarChar(32)
  encryptionAuthTag     String                @map("encryption_auth_tag") @db.VarChar(32)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  credentials           ApiCredential[]
  recipients            Recipient[]
  managedRecipients     Recipient[]           @relation("ManagedRecipients")
  outgoingPayments      Payment[]             @relation("PayerPayments")
  incomingPayments      IncomingPayment[]
  receiveRequests       ReceiveRequest[]
  idempotencyRecords    IdempotencyRecord[]
  outgoingReservations  OutgoingReservation[]
  feeSponsorships       FeeSponsorship[]
  indexerCheckpoints    IndexerCheckpoint[]
  incomingIssues        IncomingReconciliationIssue[]

  @@map("agent_accounts")
}

model ApiCredential {
  id         String       @id @db.VarChar(64)
  accountId  String       @map("account_id") @db.VarChar(64)
  keyHash    String       @unique @map("key_hash") @db.VarChar(128)
  keyPrefix  String       @map("key_prefix") @db.VarChar(32)
  createdAt  DateTime     @default(now()) @map("created_at")
  revokedAt  DateTime?    @map("revoked_at")
  lastUsedAt DateTime?    @map("last_used_at")
  account    AgentAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@map("api_credentials")
}

model Recipient {
  id               String                 @id @db.VarChar(64)
  ownerAccountId   String                 @map("owner_account_id") @db.VarChar(64)
  managedAccountId String?                @map("managed_account_id") @db.VarChar(64)
  displayName      String                 @map("display_name") @db.VarChar(120)
  type             String                 @db.VarChar(64)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  ownerAccount     AgentAccount           @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)
  managedAccount   AgentAccount?          @relation("ManagedRecipients", fields: [managedAccountId], references: [id], onDelete: Restrict)
  destinations     RecipientDestination[]
  payments         Payment[]

  @@index([ownerAccountId])
  @@index([managedAccountId])
  @@map("recipients")
}

model RecipientDestination {
  id            String    @id @db.VarChar(64)
  recipientId   String    @map("recipient_id") @db.VarChar(64)
  rail          String    @db.VarChar(64)
  type          String    @db.VarChar(64)
  walletAddress String    @map("wallet_address") @db.VarChar(128)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  recipient     Recipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([recipientId])
  @@map("recipient_destinations")
}

model Payment {
  id                        String               @id @db.VarChar(64)
  payerAccountId            String               @map("payer_account_id") @db.VarChar(64)
  payerPublicKey            String?              @map("payer_public_key") @db.VarChar(64)
  recipientId               String?              @map("recipient_id") @db.VarChar(64)
  kind                      PaymentKind
  amountAtomic              BigInt               @map("amount_atomic")
  currency                  String               @db.VarChar(3)
  status                    PaymentStatus        @default(CREATED)
  description               String?              @db.Text
  externalReference         String?              @map("external_reference") @db.VarChar(255)
  route                     String?              @db.VarChar(64)
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  confirmedAt               DateTime?            @map("confirmed_at")
  failedAt                  DateTime?            @map("failed_at")
  failureCode               String?              @map("failure_code") @db.VarChar(64)
  failureMessageSafe        String?              @map("failure_message_safe") @db.Text
  destinationRail           String?              @map("destination_rail") @db.VarChar(64)
  destinationType           String?              @map("destination_type") @db.VarChar(64)
  destinationReference      String?              @map("destination_reference") @db.VarChar(255)
  recipientManagedAccountId String?              @map("recipient_managed_account_id") @db.VarChar(64)
  originalPaymentId         String?              @map("original_payment_id") @db.VarChar(64)
  counterpartyAccountId     String?              @map("counterparty_account_id") @db.VarChar(64)
  counterpartyAddress       String?              @map("counterparty_address") @db.VarChar(128)
  lastRecoveryAttemptAt     DateTime?            @map("last_recovery_attempt_at")
  nextRecoveryAt            DateTime?            @map("next_recovery_at")
  recoveryCount             Int                  @default(0) @map("recovery_count")
  stuckSince                DateTime?            @map("stuck_since")
  payerAccount              AgentAccount         @relation("PayerPayments", fields: [payerAccountId], references: [id], onDelete: Restrict)
  recipient                 Recipient?           @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  originalPayment           Payment?             @relation("PaymentRefunds", fields: [originalPaymentId], references: [id], onDelete: Restrict)
  refunds                   Payment[]            @relation("PaymentRefunds")
  attempts                  PaymentAttempt[]
  reservation               OutgoingReservation?

  @@index([payerAccountId, createdAt])
  @@index([recipientId, createdAt])
  @@index([payerAccountId, status])
  @@index([status, nextRecoveryAt, lastRecoveryAttemptAt])
  @@map("payments")
}

model ReceiveRequest {
  id                       String               @id @db.VarChar(64)
  accountId                String               @map("account_id") @db.VarChar(64)
  amountAtomic             BigInt?              @map("amount_atomic")
  currency                 String               @db.VarChar(3)
  reference                String               @db.VarChar(255)
  status                   ReceiveRequestStatus @default(OPEN)
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  expiresAt                DateTime?            @map("expires_at")
  paidAt                   DateTime?            @map("paid_at")
  matchedIncomingPaymentId String?              @unique @map("matched_incoming_payment_id") @db.VarChar(64)
  account                  AgentAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  matchedIncomingPayment   IncomingPayment?     @relation("ReceiveMatch", fields: [matchedIncomingPaymentId], references: [id], onDelete: Restrict)
  incomingPayments         IncomingPayment?    @relation("ReceiveIncoming")

  @@unique([accountId, reference])
  @@index([accountId, status])
  @@map("receive_requests")
}

model IncomingPayment {
  id               String                @id @db.VarChar(64)
  accountId        String                @map("account_id") @db.VarChar(64)
  signature        String                @db.VarChar(128)
  amountAtomic     BigInt                @map("amount_atomic")
  tokenAtomicUnits BigInt                @map("token_atomic_units")
  tokenDecimals    Int                   @map("token_decimals")
  currency         String                @db.VarChar(3)
  sourceAddress    String?               @map("source_address") @db.VarChar(128)
  reference        String?               @db.VarChar(255)
  tokenAccount     String                @map("token_account") @db.VarChar(128)
  settlementMint   String                @map("settlement_mint") @db.VarChar(128)
  status           IncomingPaymentStatus @default(CONFIRMED)
  createdAt        DateTime              @default(now()) @map("created_at")
  confirmedAt      DateTime              @default(now()) @map("confirmed_at")
  receiveRequestId String?               @unique @map("receive_request_id") @db.VarChar(64)
  account          AgentAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  receiveRequest   ReceiveRequest?       @relation("ReceiveIncoming", fields: [receiveRequestId], references: [id], onDelete: Restrict)
  matchedByRequest ReceiveRequest?       @relation("ReceiveMatch")

  @@index([accountId, createdAt])
  @@index([accountId, receiveRequestId])
  @@unique([accountId, signature])
  @@map("incoming_payments")
}

model IndexerCheckpoint {
  id              String       @id @db.VarChar(64)
  accountId       String       @map("account_id") @db.VarChar(64)
  rail            String       @db.VarChar(64)
  address         String       @db.VarChar(128)
  cursorSignature String?      @map("cursor_signature") @db.VarChar(128)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  account         AgentAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, rail, address])
  @@map("indexer_checkpoints")
}

model IncomingReconciliationIssue {
  id          String       @id @db.VarChar(64)
  accountId   String       @map("account_id") @db.VarChar(64)
  signature   String       @db.VarChar(128)
  reason      String       @db.VarChar(128)
  firstSeenAt DateTime     @default(now()) @map("first_seen_at")
  lastTriedAt DateTime     @default(now()) @map("last_tried_at")
  retryCount  Int          @default(1) @map("retry_count")
  account     AgentAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, signature])
  @@index([accountId, lastTriedAt])
  @@map("incoming_reconciliation_issues")
}

model PaymentAttempt {
  id                            String               @id @db.VarChar(64)
  paymentId                     String               @unique @map("payment_id") @db.VarChar(64)
  attemptNumber                 Int                  @map("attempt_number")
  rail                          String               @db.VarChar(64)
  status                        PaymentAttemptStatus @default(CREATED)
  railTransactionId             String?              @map("rail_transaction_id") @db.VarChar(255)
  serializedPayloadSafe         String?              @map("serialized_payload_safe") @db.Text
  durablePayload                String?              @map("durable_payload") @db.Text
  expectedExternalId            String?              @map("expected_external_id") @db.VarChar(255)
  recoveryMetadata              String?              @map("recovery_metadata") @db.Text
  confirmationMetadata          String?              @map("confirmation_metadata") @db.Text
  legacySignedTransactionBase64 String?              @map("signed_transaction_base64") @db.Text
  legacyExpectedSignature       String?              @map("expected_signature") @db.VarChar(128)
  legacyBlockhash               String?              @map("blockhash") @db.VarChar(128)
  legacyLastValidBlockHeight    BigInt?              @map("last_valid_block_height")
  legacyConfirmedSlot           BigInt?              @map("confirmed_slot")
  createdAt                     DateTime             @default(now()) @map("created_at")
  updatedAt                     DateTime             @updatedAt @map("updated_at")
  payment                       Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, attemptNumber])
  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

model IdempotencyRecord {
  id             String       @id @db.VarChar(64)
  ownerAccountId String       @map("owner_account_id") @db.VarChar(64)
  operation      String       @db.VarChar(32)
  key            String       @db.VarChar(255)
  requestHash    String       @map("request_hash") @db.Char(64)
  resourceId     String       @map("resource_id") @db.VarChar(64)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  ownerAccount   AgentAccount @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)

  @@unique([ownerAccountId, operation, key])
  @@index([ownerAccountId, createdAt])
  @@map("idempotency_records")
}

model OutgoingReservation {
  id             String            @id @db.VarChar(64)
  paymentId      String            @unique @map("payment_id") @db.VarChar(64)
  ownerAccountId String            @map("owner_account_id") @db.VarChar(64)
  amountAtomic   BigInt            @map("amount_atomic")
  currency       String            @db.VarChar(3)
  status         ReservationStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at")
  releasedAt     DateTime?         @map("released_at")
  payment        Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  ownerAccount   AgentAccount      @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)

  @@index([ownerAccountId, status])
  @@map("outgoing_reservations")
}

model FeeSponsorship {
  id             String       @id @db.VarChar(64)
  accountId      String       @map("account_id") @db.VarChar(64)
  paymentId      String       @unique @map("payment_id") @db.VarChar(64)
  lamports       BigInt
  createdAt      DateTime     @default(now()) @map("created_at")
  account        AgentAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@map("fee_sponsorships")
}

model RuntimeMetadata {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
