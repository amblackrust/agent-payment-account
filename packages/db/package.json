{
  "name": "@agent-payment/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": {
        "development": "./src/index.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.json",
    "generate": "prisma generate --config prisma.generate.config.ts",
    "migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:format": "prisma format --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-payment/core": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "dotenv": "17.4.2",
    "prisma": "7.10.0",
    "@types/pg": "8.23.1"
  }
}
