# Reference configuration for manual or advanced setup.
# For an automated LOCAL DEVELOPMENT ONLY environment, run: pnpm local:setup

# Local PostgreSQL started by Docker Compose.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agent_payment_account?schema=public
PORT=3000
NODE_ENV=development
# Runtime role. Development defaults to all; production must choose api,
# outgoing, incoming, webhook, or maintenance explicitly.
RUNTIME_ROLE=all
# Production deployments should use a unique authority ID per promoted runtime;
# restored databases must be assigned a new value before outgoing is enabled.
# RUNTIME_AUTHORITY_ID=runtime-prod-a
# RESTORE_GATE_REQUIRED=false
# RESTORE_GATE_ENVIRONMENT=isolated-restore
# local:setup replaces this placeholder without printing the generated secret.
ADMIN_API_KEY=replace-with-a-local-admin-key
# The default local validator is project-managed and never contacts a public faucet.
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_CLUSTER=localnet
# Must be a classic SPL Token mint. local:setup creates a 6-decimal test mint.
SOLANA_SETTLEMENT_MINT=replace-with-local-token-mint
# A 64-byte Solana secret key as a JSON array, 128-char hex, or base64 string.
SOLANA_FEE_PAYER_SECRET=replace-with-64-byte-fee-payer-secret
# A 32-byte key encoded as exactly 64 hexadecimal characters.
WALLET_MASTER_KEY=replace-with-32-byte-hex-master-key
RECOVERY_ENVELOPE_KEY=replace-with-32-byte-hex-recovery-key
# Optional for the dedicated webhook worker. Inject this value from a secret
# manager; it maps "signing-key-reference:version" to base64-encoded key bytes.
# WEBHOOK_SIGNING_KEYS_JSON={"webhook-key:1":"replace-with-base64-secret"}
# BACKUP_OUTPUT_DIRECTORY=.local/backups
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_AGE_IDENTITY=/secure/restore/age-key.txt
# BACKUP_VERIFY_DATABASE_URL=postgresql://.../mux_restore
# BACKUP_VERIFY_CUSTODY_IDENTITY=provider/key-reference
# BACKUP_VERIFY_RUNTIME_AUTHORITY_ID=runtime-restore-20260917
# CUSTODY_BACKEND_IDENTITY=provider/key-reference
# Development-only outgoing worker boundary. Production must use an integrated
# EXTERNAL provider adapter; LOCAL_TEST is rejected in production.
# CUSTODY_BACKEND_IDENTITY=local-test-custody
# CUSTODY_BACKEND_MODE=LOCAL_TEST
# Mainnet remains blocked unless this and SOLANA_CLUSTER are both explicit.
ALLOW_MAINNET=false
